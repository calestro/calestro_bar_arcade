# ==========================================================================
# SEGURANÇA E AMBIENTE (CRÍTICO)
# ==========================================================================
# Nunca commite arquivos de ambiente e chaves de loja
*.env
.env
.env.*
key.properties
**/*.keystore
**/*.jks
android/app/key.jks
credentials.json
service_account.json
google-services.json
GoogleService-Info.plist

# ==========================================================================
# BANCOS DE DADOS LOCAIS
# ==========================================================================
# Ignora diretórios de dados locais (ObjectBox, Isar, Hive, SQLite) 
# Nota: objectbox-model.json deve ser commitado, mas o diretório objectbox/ não.
objectbox/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

